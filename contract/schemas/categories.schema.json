{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/slaviboy/bulgarian-driving-exam-database/contract/schemas/categories.schema.json",
  "$defs": {
    "Category": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "description": "Official label, e.g. 'C+E', 'D (103)', 'Ттм'",
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "position": {
          "minimum": 1,
          "title": "Position",
          "type": "integer"
        },
        "variants": {
          "items": {
            "$ref": "#/$defs/Variant"
          },
          "title": "Variants",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "source_id",
        "position",
        "variants"
      ],
      "title": "Category",
      "type": "object"
    },
    "Section": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "variant_id": {
          "title": "Variant Id",
          "type": "string"
        },
        "number": {
          "minimum": 1,
          "title": "Number",
          "type": "integer"
        },
        "name": {
          "description": "Full official title, e.g. 'Раздел 1. ОБЩИ СВЕДЕНИЯ ЗА АВТОМОБИЛА'",
          "title": "Name",
          "type": "string"
        },
        "topic_id": {
          "title": "Topic Id",
          "type": "string"
        },
        "position": {
          "minimum": 1,
          "title": "Position",
          "type": "integer"
        },
        "question_count": {
          "minimum": 0,
          "title": "Question Count",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "variant_id",
        "number",
        "name",
        "topic_id",
        "position",
        "question_count"
      ],
      "title": "Section",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        },
        "attribution": {
          "title": "Attribution",
          "type": "string"
        },
        "license": {
          "title": "License",
          "type": "string"
        },
        "redistribution_status": {
          "title": "Redistribution Status",
          "type": "string"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved At"
        }
      },
      "required": [
        "id",
        "name",
        "source_url",
        "attribution",
        "license",
        "redistribution_status"
      ],
      "title": "Source",
      "type": "object"
    },
    "Topic": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Topic",
      "type": "object"
    },
    "Variant": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "category_id": {
          "title": "Category Id",
          "type": "string"
        },
        "title": {
          "description": "Official <h1> of the variant file",
          "title": "Title",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "effective_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Effective Note"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        },
        "source_sha256": {
          "title": "Source Sha256",
          "type": "string"
        },
        "source_edition": {
          "title": "Source Edition",
          "type": "string"
        },
        "position": {
          "minimum": 1,
          "title": "Position",
          "type": "integer"
        },
        "question_count": {
          "minimum": 0,
          "title": "Question Count",
          "type": "integer"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/Section"
          },
          "title": "Sections",
          "type": "array"
        }
      },
      "required": [
        "id",
        "category_id",
        "title",
        "description",
        "effective_note",
        "source_url",
        "source_sha256",
        "source_edition",
        "position",
        "question_count",
        "sections"
      ],
      "title": "Variant",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "dataset_version": {
      "title": "Dataset Version",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/Source"
      },
      "title": "Sources",
      "type": "array"
    },
    "categories": {
      "items": {
        "$ref": "#/$defs/Category"
      },
      "title": "Categories",
      "type": "array"
    },
    "topics": {
      "items": {
        "$ref": "#/$defs/Topic"
      },
      "title": "Topics",
      "type": "array"
    }
  },
  "required": [
    "dataset_version",
    "sources",
    "categories",
    "topics"
  ],
  "title": "CategoriesFile",
  "type": "object"
}
