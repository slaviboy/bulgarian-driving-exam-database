# Copy to .env (never committed) or export in your shell. All values are optional.

# Where downloads, caches, media and exports are written (default: ./data)
QB_DATA_DIR=
# Where generated reports are written (default: ./reports)
QB_REPORTS_DIR=

# Politeness: minimum seconds between two requests to the same host.
# The official file server defaults to 1.0 s; AvtoIzpit can never go below 2.0 s.
QB_OFFICIAL_INTERVAL_SECONDS=1.0
QB_AVTOIZPIT_INTERVAL_SECONDS=2.0

# Request timeout and retry budget
QB_TIMEOUT_SECONDS=60
QB_MAX_RETRIES=4

# Only needed to publish releases from a local machine (CI uses its own GITHUB_TOKEN).
GITHUB_TOKEN=
